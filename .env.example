# Copy to .env and fill in. .env is gitignored. Never paste real values into chat.

# --- Telegram alerts (broadcast channel) ---
# 1. Open https://t.me/BotFather in Telegram, send /newbot, follow the prompts.
#    It replies with a token like 8123456789:AAH-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2. Create a public channel (e.g. @perpradar_alerts), add your bot as an admin.
# 3. Set TELEGRAM_CHAT_ID to the channel @username (or a numeric id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Site ---
# Public URL used in digest/alert links. Set once the domain is live.
PERPRADAR_URL=https://perpradar.example

# --- Web server ---
# PORT=4800
# HOST=0.0.0.0

# --- Stripe (paid tier — fill when ready) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
